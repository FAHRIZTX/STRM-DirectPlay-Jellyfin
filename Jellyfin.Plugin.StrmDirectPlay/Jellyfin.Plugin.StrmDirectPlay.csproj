    <AssemblyName>Jellyfin.Plugin.StrmDirectPlay</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.StrmDirectPlay</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
